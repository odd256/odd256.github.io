# 忽略规则说明：https://help.github.com/articles/ignoring-files/

# 项目依赖
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试覆盖率产物
/coverage

# Next.js 构建产物
/.next/
/out/

# 生产构建目录
/build

# 系统与其他文件
.DS_Store
*.pem

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 环境变量文件（如需提交，可单独添加例外规则）
.env*

# Vercel 部署配置
.vercel

# TypeScript 生成文件
*.tsbuildinfo
next-env.d.ts

# 自定义规则